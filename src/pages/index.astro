---
import Layout from "../layouts/Layout.astro";
import ToolHeader from "../components/ToolHeader.astro";
import WordReplacer from "../components/WordReplacer.astro";
import { CONTACT_EMAIL, KEYWORDS_META, MODIFIED, PUBLISHED, SITE_URL } from "../lib/site";

const origin = SITE_URL;
const canonical = new URL("/", origin).href;
const ogImage = new URL("/og-image.png", origin).href;
const logo = new URL("/logo.png", origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonical}#org`,
      name: "Word Replace",
      url: canonical,
      logo: {
        "@type": "ImageObject",
        url: logo,
        width: 780,
        height: 512,
      },
      sameAs: [],
      contactPoint: {
        "@type": "ContactPoint",
        email: CONTACT_EMAIL,
        contactType: "customer support",
        url: `${origin}/contact`,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${canonical}#website`,
      url: canonical,
      name: "Word Replace",
      alternateName: [
        "Text Replace",
        "Text Replacer",
        "Word Replacer Online",
        "Find and Replace Text – Free Online Tool",
      ],
      description:
        "Word Replace is a free online text replace tool to find and replace text, replace words in text, and change words in an essay in your browser.",
      inLanguage: "en",
      publisher: { "@id": `${canonical}#org` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${canonical}?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#app`,
      name: "Word Replace",
      url: canonical,
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "Text editor",
      operatingSystem: "Any",
      browserRequirements: "Requires JavaScript",
      softwareVersion: "1.0",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      featureList: [
        "Find and replace text",
        "Word replace all",
        "Replace words in text",
        "Text replace online",
        "Change words in an essay",
        "Copy and download replaced text",
      ],
      keywords: KEYWORDS_META,
      image: ogImage,
      publisher: { "@id": `${canonical}#org` },
      isAccessibleForFree: true,
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: "Word Replace | Find and Replace Text – Free Online Tool",
      isPartOf: { "@id": `${canonical}#website` },
      about: { "@id": `${canonical}#app` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImage,
        width: 1200,
        height: 630,
      },
      description:
        "Free online word replace and text replacer. Replace text online, replace words in text, and change words in an essay without uploading your draft.",
      inLanguage: "en",
      datePublished: PUBLISHED,
      dateModified: MODIFIED,
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["h1", ".tool-lead", ".seo-page h2"],
      },
      significantLink: [
        `${origin}/about`,
        `${origin}/contact`,
        `${origin}/#howto`,
        `${origin}/#faq`,
      ],
      relatedLink: [`${origin}/privacy`, `${origin}/disclaimer`],
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#sitelinks`,
      name: "Word Replace sitelinks",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Editor", url: `${origin}/#workspace` },
        { "@type": "ListItem", position: 2, name: "How to", url: `${origin}/#howto` },
        { "@type": "ListItem", position: 3, name: "Features", url: `${origin}/#features` },
        { "@type": "ListItem", position: 4, name: "FAQ", url: `${origin}/#faq` },
        { "@type": "ListItem", position: 5, name: "About", url: `${origin}/about` },
        { "@type": "ListItem", position: 6, name: "Contact", url: `${origin}/contact` },
      ],
    },
    {
      "@type": "SiteNavigationElement",
      "@id": `${canonical}#nav`,
      name: [
        "Word Replace",
        "About Word Replace",
        "Contact",
        "Privacy policy",
        "Disclaimer",
      ],
      url: [
        canonical,
        `${origin}/about`,
        `${origin}/contact`,
        `${origin}/privacy`,
        `${origin}/disclaimer`,
      ],
    },
    {
      "@type": "HowTo",
      "@id": `${canonical}#howto`,
      name: "How to replace text online with Word Replace",
      description: "Use Word Replace to find and replace text and run word replace all in your browser.",
      totalTime: "PT1M",
      supply: [],
      tool: [
        {
          "@type": "HowToTool",
          name: "Word Replace editor",
        },
      ],
      step: [
        {
          "@type": "HowToStep",
          position: 1,
          name: "Paste your text",
          text: "Paste your draft into Enter the Content.",
          url: `${canonical}#workspace`,
        },
        {
          "@type": "HowToStep",
          position: 2,
          name: "Enter the word to find",
          text: "Type the phrase to find under Replace this Word.",
          url: `${canonical}#workspace`,
        },
        {
          "@type": "HowToStep",
          position: 3,
          name: "Enter the replacement",
          text: "Type the new phrase under With.",
          url: `${canonical}#workspace`,
        },
        {
          "@type": "HowToStep",
          position: 4,
          name: "Run Word Replace",
          text: "Leave Auto on, or press Word Replace to run word replace all.",
          url: `${canonical}#workspace`,
        },
        {
          "@type": "HowToStep",
          position: 5,
          name: "Copy or download",
          text: "Copy to clipboard or download the replaced text.",
          url: `${canonical}#workspace`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: [
        {
          "@type": "Question",
          name: "Is Word Replace a free online text replace tool?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Word Replace is a free find and replace text – free online tool. You can replace text online, run word replace all, and copy the result without creating an account.",
          },
        },
        {
          "@type": "Question",
          name: "Does this word replacer online upload my draft?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Online text replace happens in your browser. Word Replace does not upload, store, or sell the text you paste.",
          },
        },
        {
          "@type": "Question",
          name: "Can I replace words in text or change words in an essay?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Paste your draft, enter the phrase to find, enter the replacement, and Word Replace will replace words in text in one pass. There is no word limit.",
          },
        },
        {
          "@type": "Question",
          name: "Is Word Replace an AI text replacer?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. This is a text replacer, not an AI word replacer. It finds the exact words you enter and replaces them. It does not rewrite meaning or generate new sentences.",
          },
        },
        {
          "@type": "Question",
          name: "Can I word replace all matches at once?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Word Replace runs word replace all on the current draft. Auto mode updates every match as you type.",
          },
        },
        {
          "@type": "Question",
          name: "Is there a word limit for this text replace online tool?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Word Replace has no word cap. Essays, emails, and longer drafts all run in one pass in your browser.",
          },
        },
        {
          "@type": "Question",
          name: "Can I copy or download the replaced text?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. After you run Word Replace, copy the result to your clipboard or download it as a text file.",
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Word Replace | Find and Replace Text – Free Online Tool"
  description="Free Word Replace tool to find and replace text online. Replace words in text, change words in an essay, and run word replace all privately in your browser."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <a class="skip-link" href="#workspace">Skip to editor</a>
  <ToolHeader />
  <main>
    <p class="tool-lead">
      Free online <strong>text replace</strong> tool. Find and replace text, replace
      words in text, and change words in an essay with no word limit.
    </p>
    <WordReplacer />
    <article class="seo-page" itemscope itemtype="https://schema.org/Article">
      <meta itemprop="headline" content="Word Replace: find and replace text – free online tool" />
      <meta itemprop="datePublished" content={PUBLISHED} />
      <meta itemprop="dateModified" content={MODIFIED} />
      <section class="seo-block">
        <header class="seo-head">
          <h2>Word Replace: find and replace text – free online tool</h2>
          <p>
            <strong>Word Replace</strong> is a free online text replace tool. Paste a
            draft, choose the phrase to change, and copy a clean result. Search text
            replace, text replace online, replace text, or replace text online and
            you land here: a word replacer to replace words online in one private
            editor. Nothing you paste is uploaded.
          </p>
        </header>
        <div class="stat-row">
          <div class="stat-card">
            <span class="card-icon-box icon-box-emerald">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <div class="stat-text">
              <b>In-browser</b>
              <span>No upload, no account</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="card-icon-box icon-box-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
            </span>
            <div class="stat-text">
              <b>No word cap</b>
              <span>Essays and long drafts</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="card-icon-box icon-box-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </span>
            <div class="stat-text">
              <b>Word replace all</b>
              <span>Every match in one pass</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="card-icon-box icon-box-amber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </span>
            <div class="stat-text">
              <b>Exact match</b>
              <span>Not an AI rewrite</span>
            </div>
          </div>
        </div>
      </section>

      <section class="seo-block" id="howto">
        <header class="seo-head">
          <h2>How to replace text online</h2>
          <p>
            Five steps for word replace all. Leave With empty to delete a phrase.
            Jump to the <a href="#workspace">Word Replace editor</a> when you are ready.
          </p>
        </header>
        <ol class="step-grid">
          <li>
            <span class="step-num step-num-1">1</span>
            <div class="step-content">
              <b>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
                Paste
              </b>
              <p>Put your draft in Enter the Content.</p>
            </div>
          </li>
          <li>
            <span class="step-num step-num-2">2</span>
            <div class="step-content">
              <b>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Find
              </b>
              <p>Type the phrase under Replace this Word.</p>
            </div>
          </li>
          <li>
            <span class="step-num step-num-3">3</span>
            <div class="step-content">
              <b>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                Replace
              </b>
              <p>Type the new phrase under With.</p>
            </div>
          </li>
          <li>
            <span class="step-num step-num-4">4</span>
            <div class="step-content">
              <b>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Run
              </b>
              <p>Keep Auto on, or press Word Replace.</p>
            </div>
          </li>
          <li>
            <span class="step-num step-num-5">5</span>
            <div class="step-content">
              <b>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy
              </b>
              <p>Copy or download the replaced text.</p>
            </div>
          </li>
        </ol>
      </section>

      <section class="seo-block" id="features">
        <header class="seo-head">
          <h2>Features of this text replace online editor</h2>
          <p>
            Two stacked boxes: green for the original, blue for the result. Replace
            this Word, With, Auto, and Word Replace stay on one row on a wide screen.
          </p>
        </header>
        <div class="card-grid">
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-cyan">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </span>
              <h3>Auto replace</h3>
            </div>
            <p>Watch every hit as you type the find or With fields.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-blue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
              </span>
              <h3>Word replace all</h3>
            </div>
            <p>One click when Auto is off. Same pass, full draft.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </span>
              <h3>Copy or download</h3>
            </div>
            <p>Take the result to clipboard or a text file.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-amber">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
              </span>
              <h3>Local draft</h3>
            </div>
            <p>A refresh keeps the page. New clears the saved copy.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-rose">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </span>
              <h3>Live counts</h3>
            </div>
            <p>Size, characters, and words under each box.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-emerald">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6"/><path d="M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              </span>
              <h3>Sample and restore</h3>
            </div>
            <p>Try sample text, restore, save original, or clear.</p>
          </article>
        </div>
      </section>

      <section class="seo-block">
        <header class="seo-head">
          <h2>Who this word replacer online is for</h2>
          <p>
            Use this editor when you need to replace text and you do not want to open
            Word or Google Docs. No word cap, so essays and short replies use the same
            page. Read <a href="/about">about Word Replace</a> or
            <a href="/contact">contact</a> if something is missing.
          </p>
        </header>
        <div class="card-grid three">
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </span>
              <h3>Students</h3>
            </div>
            <p>Change words in an essay after a teacher asks for a different term.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-blue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </span>
              <h3>Editors</h3>
            </div>
            <p>Word replacer online when house style shifts from one phrase to another.</p>
          </article>
          <article class="info-card">
            <div class="card-head">
              <span class="card-icon-box icon-box-emerald">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </span>
              <h3>Teams</h3>
            </div>
            <p>Replace words in text for a brand name in emails and support replies.</p>
          </article>
        </div>
      </section>

      <section class="seo-block">
        <header class="seo-head">
          <h2>Word Replace vs AI text replacer</h2>
          <p>
            Search results mix find and replace, rewrite, and generate. Word Replace
            only does the first. If you want to <strong>change words</strong> without
            changing meaning, stay here.
          </p>
        </header>
        <div class="compare">
          <div class="compare-col yes">
            <div class="compare-header">
              <span class="card-icon-box icon-box-emerald">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </span>
              <div>
                <h3>Word Replace</h3>
                <span class="col-pill pill-yes">Deterministic</span>
              </div>
            </div>
            <ul>
              <li>
                <span class="icon-bullet yes-bullet">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                Finds the exact string you typed
              </li>
              <li>
                <span class="icon-bullet yes-bullet">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                Runs word replace all in the browser
              </li>
              <li>
                <span class="icon-bullet yes-bullet">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                Does not upload the draft
              </li>
              <li>
                <span class="icon-bullet yes-bullet">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                No account and no word limit
              </li>
            </ul>
          </div>
          <div class="compare-col no">
            <div class="compare-header">
              <span class="card-icon-box icon-box-rose">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              </span>
              <div>
                <h3>AI text replacer</h3>
                <span class="col-pill pill-no">Probabilistic</span>
              </div>
            </div>
            <ul>
              <li>
                <span class="icon-bullet no-bullet">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </span>
                May paraphrase nearby sentences
              </li>
              <li>
                <span class="icon-bullet no-bullet">

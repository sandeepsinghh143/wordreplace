---
---

<div class="tool" id="workspace">
  <section class="tool-block">
    <div class="tool-row">
      <h2>Enter the Content</h2>
      <div class="tool-icons">
        <button type="button" data-sample>Sample</button>
        <button type="button" title="Restore last draft" data-restore>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="8.2"></circle>
            <path d="M12 8v4.4l3 1.6"></path>
          </svg>
        </button>
        <button type="button" title="Save original" data-save-source>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M5 5h11.2L19 7.8V19H5V5Z"></path>
            <path d="M8 5v4.5h8V5M8 19v-6h8v6"></path>
          </svg>
        </button>
        <button type="button" title="Clear" data-clear>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M5 7h14M9.5 7V5.5h5V7M7.5 7l.8 12h7.4l.8-12"></path>
          </svg>
        </button>
        <button type="button" title="Copy original" data-copy-source>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="8.5" y="8.5" width="11" height="11" rx="1.5"></rect>
            <path d="M15.5 8.5V5.8A1.3 1.3 0 0 0 14.2 4.5H5.8A1.3 1.3 0 0 0 4.5 5.8v8.4A1.3 1.3 0 0 0 5.8 15.5H8.5"></path>
          </svg>
        </button>
      </div>
    </div>
    <textarea class="area area-in" data-source placeholder="Enter Content"></textarea>
    <p class="size" data-source-size>Size : <b>0</b> B, 0 Characters, 0 Words</p>
  </section>

  <section class="replace-bar">
    <label class="inline-field">
      <span>Replace this Word:</span>
      <input type="text" data-find placeholder="Search" autocomplete="off" spellcheck="false" />
    </label>
    <label class="inline-field">
      <span>With:</span>
      <input type="text" data-replace placeholder="Replace with" autocomplete="off" spellcheck="false" />
    </label>
    <label class="auto">
      <input type="checkbox" data-auto checked />
      Auto
    </label>
    <button class="btn-mint" type="button" data-run>Word Replace</button>
  </section>

  <section class="tool-block">
    <div class="tool-row">
      <h2>Content After Replace Text</h2>
      <button type="button" class="icon-btn" title="Copy result" data-copy-result>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="8.5" y="8.5" width="11" height="11" rx="1.5"></rect>
          <path d="M15.5 8.5V5.8A1.3 1.3 0 0 0 14.2 4.5H5.8A1.3 1.3 0 0 0 4.5 5.8v8.4A1.3 1.3 0 0 0 5.8 15.5H8.5"></path>
        </svg>
      </button>
    </div>
    <textarea class="area area-out" data-result readonly placeholder="Replaced Content with new Text"></textarea>
    <p class="size" data-result-size>Size : <b>0</b> B, 0 Characters, 0 Words</p>
  </section>

  <section class="bottom-actions">
    <button class="btn-outline wide" type="button" data-copy-result-btn>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="8.5" y="8.5" width="11" height="11" rx="1.5"></rect>
        <path d="M15.5 8.5V5.8A1.3 1.3 0 0 0 14.2 4.5H5.8A1.3 1.3 0 0 0 4.5 5.8v8.4A1.3 1.3 0 0 0 5.8 15.5H8.5"></path>
      </svg>
      Copy To Clipboard
    </button>
    <button class="btn-outline wide" type="button" data-download>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M12 5v9M8.5 10.5 12 14l3.5-3.5M5 19h14"></path>
      </svg>
      Download
    </button>
  </section>
</div>

<script>
  const STORAGE_KEY = "text-replacer-draft";
  const SAMPLE = `The quick brown fox jumps over the lazy dog.
She sells seashells by the seashore.
The fox is quick, and the dog is lazy.`;

  const sourceEl = document.querySelector("[data-source]");
  const findEl = document.querySelector("[data-find]");
  const replaceEl = document.querySelector("[data-replace]");
  const autoEl = document.querySelector("[data-auto]");
  const resultEl = document.querySelector("[data-result]");
  const sourceSizeEl = document.querySelector("[data-source-size]");
  const resultSizeEl = document.querySelector("[data-result-size]");
  const runEl = document.querySelector("[data-run]");

  if (
    !(sourceEl instanceof HTMLTextAreaElement) ||
    !(findEl instanceof HTMLInputElement) ||
    !(replaceEl instanceof HTMLInputElement) ||
    !(autoEl instanceof HTMLInputElement) ||
    !(resultEl instanceof HTMLTextAreaElement)
  ) {
    throw new Error("Editor markup missing");
  }

  let manualResult = "";

  function countWords(value) {
    const trimmed = value.trim();
    if (!trimmed) return 0;
    return trimmed.split(/\s+/).length;
  }

  function escapeRegExp(value) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function buildPattern(find) {
    if (!find) return null;
    try {
      return new RegExp(escapeRegExp(find), "gi");
    } catch {
      return null;
    }
  }

  function replaceAll(text, pattern, replacement) {
    if (!pattern) return text;
    return text.replace(new RegExp(pattern.source, pattern.flags), replacement);
  }

  function byteSize(value) {
    return new Blob([value]).size;
  }

  function downloadText(filename, value) {
    const blob = new Blob([value], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  async function copyText(value) {
    if (!value) return;
    try {
      await navigator.clipboard.writeText(value);
    } catch {
      const area = document.createElement("textarea");
      area.value = value;
      document.body.appendChild(area);
      area.select();
      document.execCommand("copy");
      document.body.removeChild(area);
    }
  }

  function currentResult() {
    const source = sourceEl.value;
    if (autoEl.checked) {
      const pattern = buildPattern(findEl.value);
      if (!source || !findEl.value) return source;
      return replaceAll(source, pattern, replaceEl.value);
    }
    return manualResult;
  }

  function setSize(el, value) {
    if (!(el instanceof HTMLElement)) return;
    const words = countWords(value);
    el.classList.remove("over");
    el.innerHTML = `Size : <b>${byteSize(value)}</b> B, ${value.length} Characters, ${words} Words`;
  }

  function render() {
    const source = sourceEl.value;
    const result = currentResult();
    resultEl.value = result;
    setSize(sourceSizeEl, source);
    setSize(resultSizeEl, result);
    sourceEl.removeAttribute("aria-invalid");
    const canUse = Boolean(result);
    document.querySelectorAll("[data-copy-result], [data-copy-result-btn], [data-download]").forEach((node) => {
      if (node instanceof HTMLButtonElement) node.disabled = !canUse;
    });
    const save = document.querySelector("[data-save-source]");
    const copySource = document.querySelector("[data-copy-source]");
    if (save instanceof HTMLButtonElement) save.disabled = !source;
    if (copySource instanceof HTMLButtonElement) copySource.disabled = !source;
    if (runEl instanceof HTMLButtonElement) runEl.disabled = false;
  }

  function persist() {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          source: sourceEl.value,
          findText: findEl.value,
          replaceWith: replaceEl.value,
        })
      );
    } catch {
      /* ignore */
    }
  }

  function loadSaved() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return;
      const parsed = JSON.parse(saved);
      sourceEl.value = parsed.source ?? "";
      findEl.value = parsed.findText ?? "";
      replaceEl.value = parsed.replaceWith ?? "";
    } catch {
      /* ignore */
    }
  }

  function clearAll() {
    sourceEl.value = "";
    findEl.value = "";
    replaceEl.value = "";
    manualResult = "";
    sourceEl.focus();
    persist();
    render();
  }

  loadSaved();
  render();

  sourceEl.addEventListener("input", () => {
    persist();
    render();
  });
  findEl.addEventListener("input", () => {
    persist();
    render();
  });
  replaceEl.addEventListener("input", () => {
    persist();
    render();
  });
  autoEl.addEventListener("change", render);

  document.querySelector("[data-sample]")?.addEventListener("click", () => {
    sourceEl.value = SAMPLE;
    persist();
    render();
  });
  document.querySelector("[data-restore]")?.addEventListener("click", () => {
    loadSaved();
    render();
  });
  document.querySelector("[data-save-source]")?.addEventListener("click", () => {
    if (sourceEl.value) downloadText("original-text.txt", sourceEl.value);
  });
  document.querySelector("[data-clear]")?.addEventListener("click", clearAll);
  document.querySelector("[data-copy-source]")?.addEventListener("click", () => {
    void copyText(sourceEl.value);
  });
  runEl?.addEventListener("click", () => {
    const source = sourceEl.value;
    if (!source.trim() || !findEl.value) {
      manualResult = source;
    } else {
      manualResult = replaceAll(source, buildPattern(findEl.value), replaceEl.value);
    }
    render();
  });
  document.querySelectorAll("[data-copy-result], [data-copy-result-btn]").forEach((node) => {
    node.addEventListener("click", () => {
      void copyText(resultEl.value);
    });
  });
  document.querySelector("[data-download]")?.addEventListener("click", () => {
    if (resultEl.value) downloadText("replaced-text.txt", resultEl.value);
  });
  window.addEventListener("word-replace-new", clearAll);
</script>
